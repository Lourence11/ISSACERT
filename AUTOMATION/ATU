def copy_cell_style(source_cell, target_cell):
    target_cell._style = copy(source_cell._style)
    target_cell.font = copy(source_cell.font)
    target_cell.fill = copy(source_cell.fill)
    target_cell.border = copy(source_cell.border)
    target_cell.alignment = copy(source_cell.alignment)
    target_cell.protection = copy(source_cell.protection)
    target_cell.number_format = source_cell.number_format


def choose_style_source_cell(worksheet, row_index, preferred_columns):
    for column_index in preferred_columns:
        if not column_index:
            continue
        if column_index < 1 or column_index > worksheet.max_column:
            continue
        return worksheet.cell(row=row_index, column=column_index)

    return worksheet.cell(row=row_index, column=1)


def get_display_text(value):
    if value is None:
        return ""

    if isinstance(value, datetime):
        return value.strftime("%m/%d/%Y %H:%M:%S")

    if hasattr(value, "year") and hasattr(value, "month") and hasattr(value, "day") and not isinstance(value, str):
        return value.strftime("%m/%d/%Y")

    if isinstance(value, float):
        text = f"{value:,.2f}".rstrip("0").rstrip(".")
        return text if text else "0"

    return str(value).strip()


def apply_safe_column_widths(workbook, min_width=12, max_width=60):
    for worksheet in workbook.worksheets:
        for col_index in range(1, worksheet.max_column + 1):
            column_letter = get_column_letter(col_index)
            max_length = 0

            for row_index in range(1, worksheet.max_row + 1):
                cell = worksheet.cell(row=row_index, column=col_index)
                display_text = get_display_text(cell.value)
                if display_text:
                    max_length = max(max_length, len(display_text))

            existing_width = worksheet.column_dimensions[column_letter].width or 0
            target_width = max(min_width, existing_width, max_length + 2)
            worksheet.column_dimensions[column_letter].width = min(target_width, max_width)


def get_excel_color_index(workbook, cache, color):
    if color is None or getattr(color, "type", None) != "rgb" or not color.rgb:
        return None

    rgb = color.rgb[-6:].upper()
    if len(rgb) != 6:
        return None

    if rgb in cache:
        return cache[rgb]

    next_index = 8 + len(cache)
    if next_index > 63:
        return None

    workbook.set_colour_RGB(next_index, int(rgb[0:2], 16), int(rgb[2:4], 16), int(rgb[4:6], 16))
    cache[rgb] = next_index
    return next_index


def build_xlwt_style(workbook, color_cache, style_cache, cell):
    style_key = (
        str(cell.font),
        str(cell.fill),
        str(cell.border),
        str(cell.alignment),
        cell.number_format,
    )
    if style_key in style_cache:
        return style_cache[style_key]

    style = xlwt.XFStyle()
    style.num_format_str = cell.number_format or "General"

    font = xlwt.Font()
    if cell.font:
        font.name = cell.font.name or "Arial"
        if cell.font.sz:
            font.height = int(float(cell.font.sz) * 20)
        font.bold = bool(cell.font.bold)
        font.italic = bool(cell.font.italic)
        font.struck_out = bool(cell.font.strike)
        if cell.font.underline and cell.font.underline != "none":
            font.underline = xlwt.Font.UNDERLINE_SINGLE
        if cell.font.color:
            font_color_index = get_excel_color_index(workbook, color_cache, cell.font.color)
            if font_color_index is not None:
                font.colour_index = font_color_index
    style.font = font

    alignment = xlwt.Alignment()
    horizontal_map = {
        "left": xlwt.Alignment.HORZ_LEFT,
        "center": xlwt.Alignment.HORZ_CENTER,
        "right": xlwt.Alignment.HORZ_RIGHT,
        "justify": xlwt.Alignment.HORZ_JUSTIFIED,
        "distributed": xlwt.Alignment.HORZ_DISTRIBUTED,
        "fill": xlwt.Alignment.HORZ_FILLED,
        "centerContinuous": xlwt.Alignment.HORZ_CENTER_ACROSS_SEL,
    }
    vertical_map = {
        "top": xlwt.Alignment.VERT_TOP,
        "center": xlwt.Alignment.VERT_CENTER,
        "bottom": xlwt.Alignment.VERT_BOTTOM,
        "justify": xlwt.Alignment.VERT_JUSTIFIED,
        "distributed": xlwt.Alignment.VERT_DISTRIBUTED,
    }
    if cell.alignment:
        if cell.alignment.horizontal in horizontal_map:
            alignment.horz = horizontal_map[cell.alignment.horizontal]
        if cell.alignment.vertical in vertical_map:
            alignment.vert = vertical_map[cell.alignment.vertical]
        alignment.wrap = 1 if cell.alignment.wrap_text else 0
    style.alignment = alignment

    pattern = xlwt.Pattern()
    if cell.fill and cell.fill.fill_type == "solid":
        fill_color_index = get_excel_color_index(workbook, color_cache, cell.fill.fgColor)
        if fill_color_index is not None:
            pattern.pattern = xlwt.Pattern.SOLID_PATTERN
            pattern.pattern_fore_colour = fill_color_index
    style.pattern = pattern

    border_style_map = {
        "thin": xlwt.Borders.THIN,
        "medium": xlwt.Borders.MEDIUM,
        "thick": xlwt.Borders.THICK,
        "dashed": xlwt.Borders.DASHED,
        "dotted": xlwt.Borders.DOTTED,
        "double": xlwt.Borders.DOUBLE,
        "hair": xlwt.Borders.HAIR,
        "dashDot": xlwt.Borders.THIN_DASH_DOTTED,
        "dashDotDot": xlwt.Borders.THIN_DASH_DOT_DOTTED,
        "mediumDashed": xlwt.Borders.MEDIUM_DASHED,
        "mediumDashDot": xlwt.Borders.MEDIUM_DASH_DOTTED,
        "mediumDashDotDot": xlwt.Borders.MEDIUM_DASH_DOT_DOTTED,
        "slantDashDot": xlwt.Borders.SLANTED_MEDIUM_DASH_DOTTED,
    }
    borders = xlwt.Borders()
    if cell.border:
        for edge_name in ("left", "right", "top", "bottom"):
            edge = getattr(cell.border, edge_name)
            if not edge:
                continue

            line_style = border_style_map.get(edge.style)
            if line_style is not None:
                setattr(borders, edge_name, line_style)

            if edge.color:
                edge_color_index = get_excel_color_index(workbook, color_cache, edge.color)
                if edge_color_index is not None:
                    setattr(borders, f"{edge_name}_colour", edge_color_index)
    style.borders = borders

    style_cache[style_key] = style
    return style


def row_has_values(worksheet, row_index):
    for column_index in range(1, worksheet.max_column + 1):
        value = worksheet.cell(row=row_index, column=column_index).value
        if value is None:
            continue
        if isinstance(value, str) and not value.strip():
            continue
        return True
    return False


def has_meaningful_value(value):
    if value is None:
        return False
    if isinstance(value, str) and not value.strip():
        return False
    return True


def parse_numeric_value(value):
    if value is None:
        return 0.0

    if isinstance(value, bool):
        return 0.0

    if isinstance(value, (int, float)):
        return float(value)

    text = str(value).strip()
    if not text:
        return 0.0

    normalized = (
        text.replace(",", "")
        .replace("₱", "")
        .replace("â‚±", "")
        .replace(" ", "")
        .replace("(", "-")
        .replace(")", "")
    )

    try:
        return float(normalized)
    except ValueError:
        return 0.0


def find_header_position(worksheet, header_candidates):
    normalized_candidates = {normalize_header_key(candidate) for candidate in header_candidates}

    for row_index in range(1, min(worksheet.max_row, HEADER_SCAN_ROWS) + 1):
        for col_index in range(1, worksheet.max_column + 1):
            value = worksheet.cell(row=row_index, column=col_index).value
            if not isinstance(value, str):
                continue
            if normalize_header_key(value) in normalized_candidates:
                return row_index, col_index, value.strip()

    return None


def load_agent_state():
    default_state = {"last_agent_index": -1, "last_agent": ""}
    if not os.path.exists(AGENT_STATE_FILE):
        return default_state

    try:
        with open(AGENT_STATE_FILE, "r", encoding="utf-8") as file_handle:
            raw_state = json.load(file_handle)
    except Exception:
        return default_state

    last_agent_index = raw_state.get("last_agent_index", -1)
    try:
        last_agent_index = int(last_agent_index)
    except Exception:
        last_agent_index = -1

    if last_agent_index < -1 or last_agent_index >= len(AGENT_SEQUENCE):
        last_agent_index = -1

    last_agent = raw_state.get("last_agent", "")
    if not isinstance(last_agent, str):
        last_agent = ""

    return {
        "last_agent_index": last_agent_index,
        "last_agent": last_agent,
    }


def save_agent_state(last_agent_index):
    if last_agent_index < 0:
        state = {"last_agent_index": -1, "last_agent": ""}
    else:
        state = {
            "last_agent_index": int(last_agent_index),
            "last_agent": AGENT_SEQUENCE[int(last_agent_index)],
        }

    with open(AGENT_STATE_FILE, "w", encoding="utf-8") as file_handle:
        json.dump(state, file_handle)


def find_insert_anchor_position(worksheet):
    priority_position = find_header_position(worksheet, PRIORITY_HEADER_CANDIDATES)
    if priority_position is not None:
        return ("priority", *priority_position)

    letter_status_position = find_header_position(worksheet, LETTER_STATUS_HEADER_CANDIDATES)
    if letter_status_position is not None:
        return ("letter_status", *letter_status_position)

    return None


