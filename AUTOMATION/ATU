def normalize_header_key(value):
    if not isinstance(value, str):
        return ""

    normalized = value.strip().replace("\n", " ").replace("\r", " ")
    normalized = re.sub(r"\s+", " ", normalized)
    normalized = normalized.replace(" ", "_")
    return normalized.casefold()


NORMALIZED_HEADER_RENAMES = {
    normalize_header_key(original_header): updated_header
    for original_header, updated_header in HEADER_RENAMES.items()
}


def extract_worklist_date(file_name):
    if not file_name:
        raise ValueError("Missing file name.")

    match = WORKLIST_FILENAME_PATTERN.search(file_name)
    if match is None:
        raise ValueError(
            f'File name must contain "{WORKLIST_EXPECTED_PREFIX}" followed by a 6-digit date code like "041626".'
        )

    raw_code = match.group(1)
    try:
        parsed_date = datetime.strptime(raw_code, "%m%d%y").date()
    except ValueError as error:
        raise ValueError(
            f'Invalid date code "{raw_code}". Expected a valid MMDDYY value such as "041626".'
        ) from error

    return raw_code, parsed_date


def extract_endorsement_date(file_name):
    if not file_name:
        raise ValueError("Missing file name.")

    match = ENDORSEMENT_FILENAME_PATTERN.search(file_name)
    if match is None:
        raise ValueError(
            f'File name must contain "{ENDORSEMENT_EXPECTED_PREFIX}" followed by a date like "04.15.2026".'
        )

    raw_code = match.group(1)
    try:
        parsed_date = datetime.strptime(raw_code, "%m.%d.%Y").date()
    except ValueError as error:
        raise ValueError(
            f'Invalid date code "{raw_code}". Expected a valid MM.DD.YYYY value such as "04.15.2026".'
        ) from error

    return raw_code, parsed_date


def detect_automation_type(file_name):
    if WORKLIST_FILENAME_PATTERN.search(file_name or ""):
        return "worklist"
    if ENDORSEMENT_FILENAME_PATTERN.search(file_name or ""):
        return "endorsement"

    raise ValueError(
        'Unsupported file name. Use either "SPM WORKLIST 041626" or "FOR ENDORSEMENT_MADRID 04.15.2026".'
    )


def decrypt_excel_bytes(raw_bytes, password):
    decrypted = BytesIO()
    office_file = msoffcrypto.OfficeFile(BytesIO(raw_bytes))
    office_file.load_key(password=password)
    office_file.decrypt(decrypted)
    decrypted.seek(0)
    return decrypted.getvalue()


def get_password_candidates(file_name, password=None):
    password_candidates = []
    if password:
        password_candidates.append(password)

    automation_type = detect_automation_type(file_name)
    default_passwords = {
        "worklist": DEFAULT_WORKLIST_PASSWORD,
        "endorsement": DEFAULT_ENDORSEMENT_PASSWORD,
    }

    default_password = default_passwords.get(automation_type)
    if default_password and default_password not in password_candidates:
        password_candidates.append(default_password)

    for fallback_password in (DEFAULT_WORKLIST_PASSWORD, DEFAULT_ENDORSEMENT_PASSWORD):
        if fallback_password not in password_candidates:
            password_candidates.append(fallback_password)

    return password_candidates


def load_excel_bytes(uploaded_file, file_name, password=None):
    uploaded_file.seek(0)
    raw_bytes = uploaded_file.read()

    try:
        openpyxl.load_workbook(BytesIO(raw_bytes), read_only=True, data_only=True)
        return raw_bytes
    except Exception as direct_error:
        password_candidates = get_password_candidates(file_name, password=password)

        decrypt_errors = []
        for candidate_password in password_candidates:
            try:
                decrypted_bytes = decrypt_excel_bytes(raw_bytes, candidate_password)
                openpyxl.load_workbook(BytesIO(decrypted_bytes), read_only=True, data_only=True)
                return decrypted_bytes
            except Exception as decrypt_error:
                decrypt_errors.append(f'{candidate_password}: {decrypt_error}')

        raise ValueError(
            "Unable to open the Excel file. "
            f"Direct open error: {direct_error}. "
            f"Tried passwords: {', '.join(password_candidates)}. "
            f"Password open errors: {' | '.join(decrypt_errors)}"
        ) from direct_error


