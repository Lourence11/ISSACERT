def process_uploaded_excel(uploaded_file, password=None):
    automation_type = detect_automation_type(uploaded_file.name)
    excel_bytes = load_excel_bytes(uploaded_file, uploaded_file.name, password=password or None)
    sheet_names = load_sheet_names(excel_bytes)
    rename_details = []
    insertion_details = []
    assignment_details = []
    saved_agent = ""

    if automation_type == "worklist":
        date_code, file_date = extract_worklist_date(uploaded_file.name)
        processed_excel_bytes, rename_details = rename_headers_in_workbook(excel_bytes)
        processed_excel_bytes, insertion_details = add_letter_status_columns(processed_excel_bytes)
        account_row_count = get_account_row_count(processed_excel_bytes)
        preview_help_text = 'Columns now start at `PRIORITY` when that header exists, otherwise the block is inserted after `LETTER_TATUS` or `LETTER_STATUS`.'
        preview_columns = None
        output_file_name = build_output_file_name(account_row_count)
    else:
        date_code, file_date = extract_endorsement_date(uploaded_file.name)
        processed_excel_bytes, assignment_details, account_row_count, saved_agent = add_endorsement_columns_and_assign_agents(excel_bytes)
        preview_help_text = 'The last two columns are `AGENT` and `Total Amount Due (based on system)`, and `AGENT` is assigned in the order MMEV, CJNP, MLRP.'
        preview_columns = ENDORSEMENT_DISPLAY_COLUMNS
        output_file_name = build_endorsement_output_file_name(account_row_count)

    processed_excel_97_bytes = convert_xlsx_bytes_to_xls_bytes(processed_excel_bytes)

    return {
        "source_file_name": uploaded_file.name,
        "automation_type": automation_type,
        "date_code": date_code,
        "file_date": file_date,
        "sheet_names": sheet_names,
        "rename_details": rename_details,
        "insertion_details": insertion_details,
        "assignment_details": assignment_details,
        "saved_agent": saved_agent,
        "account_row_count": account_row_count,
        "processed_excel_bytes": processed_excel_bytes,
        "processed_excel_97_bytes": processed_excel_97_bytes,
        "preview_help_text": preview_help_text,
        "preview_columns": preview_columns,
        "output_file_name": output_file_name,
    }


def build_batch_zip(results):
    output = BytesIO()
    with ZipFile(output, "w", compression=ZIP_DEFLATED) as zip_file:
        for file_index, result in enumerate(results, start=1):
            zip_file.writestr(f"{file_index:02d}_{result['output_file_name']}", result["processed_excel_97_bytes"])

    output.seek(0)
    return output


def run():
    st.title(APP_TITLE)
    st.caption(
        'Supports two file types: "SPM WORKLIST 041626" and "FOR ENDORSEMENT_MADRID 04.15.2026".'
    )

    uploaded_files = st.file_uploader(
        "Upload Excel file(s)",
        type=["xlsx", "xlsm"],
        accept_multiple_files=True,
        help='Expected filename format: either "SPM WORKLIST 041626.xlsx" or "FOR ENDORSEMENT_MADRID 04.15.2026.xlsx"',
    )
    password = st.text_input(
        "Excel password if needed",
        type="password",
        value="",
        help='The app automatically tries "SPM2026" for SPM WORKLIST and "Madrid*123" for FOR ENDORSEMENT_MADRID.',
    )

    if not uploaded_files:
        st.info('Upload one or more Excel files named like "SPM WORKLIST 041626.xlsx" or "FOR ENDORSEMENT_MADRID 04.15.2026.xlsx".')
        return

    results = []
    errors = []

    for upload_index, uploaded_file in enumerate(uploaded_files, start=1):
        try:
            results.append(process_uploaded_excel(uploaded_file, password=password or None))
        except Exception as error:
            errors.append({"file_name": uploaded_file.name, "error": str(error), "index": upload_index})

    metric_col_1, metric_col_2, metric_col_3, metric_col_4 = st.columns(4)
    metric_col_1.metric("Files Uploaded", len(uploaded_files))
    metric_col_2.metric("Processed", len(results))
    metric_col_3.metric("Failed", len(errors))
    metric_col_4.metric("Total Acc Rows", sum(result["account_row_count"] for result in results))

    if results:
        st.success("Batch processing completed.")
        st.caption('The app automatically tries "SPM2026" for SPM WORKLIST and "Madrid*123" for FOR ENDORSEMENT_MADRID, and every download is exported as an unprotected Excel 97-2003 Workbook (.xls).')

        batch_zip = build_batch_zip(results)
        st.download_button(
            label="Download All Processed Files",
            data=batch_zip.getvalue(),
            file_name=f"ATU_BATCH_{datetime.today().strftime('%Y-%m-%d')}.zip",
            mime="application/zip",
        )

    if errors:
        st.error("Some files could not be processed.")
        st.dataframe(pd.DataFrame(errors), use_container_width=True, hide_index=True)

    for result_index, result in enumerate(results, start=1):
        title = f"{result_index}. {result['source_file_name']} ({result['automation_type'].replace('_', ' ').title()})"
        with st.expander(title, expanded=(result_index == 1)):
            detail_col_1, detail_col_2, detail_col_3, detail_col_4, detail_col_5, detail_col_6 = st.columns(6)
            detail_col_1.metric("File Date", result["file_date"].strftime("%m/%d/%Y"))
            detail_col_2.metric("Sheet Count", len(result["sheet_names"]))
            detail_col_3.metric("Headers Renamed", len(result["rename_details"]))
            detail_col_4.metric("Column Updates", len(result["insertion_details"]) if result["automation_type"] == "worklist" else len(result["assignment_details"]))
            detail_col_5.metric("Acc Rows", result["account_row_count"])
            detail_col_6.metric("Automation", result["automation_type"].replace("_", " ").title())

            st.write(f"Source file: `{result['source_file_name']}`")
            expected_prefix = WORKLIST_EXPECTED_PREFIX if result["automation_type"] == "worklist" else ENDORSEMENT_EXPECTED_PREFIX
            st.write(f"Expected prefix: `{expected_prefix}`")
            st.write("Sheets found:")
            st.write(", ".join(result["sheet_names"]))

            if result["automation_type"] == "worklist":
                if result["rename_details"]:
                    st.write("Header changes applied:")
                    st.dataframe(pd.DataFrame(result["rename_details"]), use_container_width=True, hide_index=True)
                else:
                    st.write('No header named `"Pincipal_Amount"` or `"Principal_Amount"` was found in the scanned header rows.')
                if result["insertion_details"]:
                    st.write(result["preview_help_text"])
                    st.dataframe(pd.DataFrame(result["insertion_details"]), use_container_width=True, hide_index=True)
                else:
                    st.write('No header named `PRIORITY`, `LETTER_TATUS`, or `LETTER_STATUS` was found in the scanned header rows.')
            else:
                st.write(result["preview_help_text"])
                if result["assignment_details"]:
                    st.dataframe(pd.DataFrame(result["assignment_details"]), use_container_width=True, hide_index=True)
                    st.write(f'Last saved agent in `{AGENT_STATE_FILE}`: `{result["saved_agent"]}`')
                else:
                    st.write("No sheet with an account number header was found in the scanned header rows.")

            selected_sheet = st.selectbox(
                "Preview a sheet",
                options=result["sheet_names"],
                key=f"atu_preview_sheet_{result_index}",
            )
            if result["preview_columns"]:
                preview_df = preview_sheet_columns(result["processed_excel_bytes"], selected_sheet, result["preview_columns"])
            else:
                preview_df = preview_sheet(result["processed_excel_bytes"], selected_sheet)
            st.dataframe(preview_df, use_container_width=True, hide_index=True)

            st.download_button(
                label="Download Updated File",
                data=result["processed_excel_97_bytes"],
                file_name=result["output_file_name"],
                mime="application/vnd.ms-excel",
                key=f"atu_download_file_{result_index}",
            )


if __name__ == "__main__":
    run()
