def get_account_row_count(excel_bytes):
    workbook = openpyxl.load_workbook(BytesIO(excel_bytes), read_only=True, data_only=True)
    total_rows = 0

    for worksheet in workbook.worksheets:
        anchor_position = find_insert_anchor_position(worksheet)
        if anchor_position is None:
            continue

        header_row = anchor_position[1]
        sheet_rows = 0
        for row_index in range(header_row + 1, worksheet.max_row + 1):
            if row_has_values(worksheet, row_index):
                sheet_rows += 1

        total_rows += sheet_rows

    if total_rows > 0:
        return total_rows

    first_sheet = workbook[workbook.sheetnames[0]]
    fallback_rows = 0
    for row_index in range(2, first_sheet.max_row + 1):
        if row_has_values(first_sheet, row_index):
            fallback_rows += 1

    return fallback_rows


def rename_headers_in_workbook(excel_bytes):
    workbook = openpyxl.load_workbook(BytesIO(excel_bytes))
    rename_details = []

    for worksheet in workbook.worksheets:
        for row_index in range(1, min(worksheet.max_row, HEADER_SCAN_ROWS) + 1):
            for col_index in range(1, worksheet.max_column + 1):
                cell = worksheet.cell(row=row_index, column=col_index)
                if not isinstance(cell.value, str):
                    continue

                current_header = cell.value.strip()
                replacement_header = NORMALIZED_HEADER_RENAMES.get(normalize_header_key(current_header))
                if replacement_header is None:
                    continue

                cell.value = replacement_header
                rename_details.append(
                    {
                        "Sheet": worksheet.title,
                        "Row": row_index,
                        "Column": col_index,
                        "Original Header": current_header,
                        "Updated Header": replacement_header,
                    }
                )

    output = BytesIO()
    workbook.save(output)
    output.seek(0)
    return output.getvalue(), rename_details


def add_letter_status_columns(excel_bytes):
    workbook = openpyxl.load_workbook(BytesIO(excel_bytes))
    insertion_details = []

    expected_headers = [header for header, _ in LETTER_STATUS_INSERT_COLUMNS]

    for worksheet in workbook.worksheets:
        anchor_position = find_insert_anchor_position(worksheet)
        if anchor_position is None:
            continue

        anchor_type, header_row, anchor_col, anchor_header = anchor_position
        if anchor_type == "priority":
            start_col = anchor_col
            existing_headers = [
                worksheet.cell(row=header_row, column=start_col + offset).value
                for offset in range(len(LETTER_STATUS_INSERT_COLUMNS))
            ]
        else:
            start_col = anchor_col + 1
            existing_headers = [
                worksheet.cell(row=header_row, column=start_col + offset).value
                for offset in range(len(LETTER_STATUS_INSERT_COLUMNS))
            ]

        normalized_existing_headers = [
            value.strip().casefold() if isinstance(value, str) else None
            for value in existing_headers
        ]
        normalized_expected_headers = [header.casefold() for header in expected_headers]

        inserted_new_columns = normalized_existing_headers != normalized_expected_headers

        if inserted_new_columns:
            if anchor_type == "priority":
                insert_at_col = anchor_col + 1
                columns_to_insert = len(LETTER_STATUS_INSERT_COLUMNS) - 1
                source_header_cell = worksheet.cell(row=header_row, column=anchor_col)
                worksheet.insert_cols(insert_at_col, amount=columns_to_insert)
                header_targets = [(anchor_col, expected_headers[0])] + [
                    (anchor_col + offset, new_header)
                    for offset, (new_header, _) in enumerate(LETTER_STATUS_INSERT_COLUMNS[1:], start=1)
                ]
            else:
                insert_at_col = anchor_col + 1
                columns_to_insert = len(LETTER_STATUS_INSERT_COLUMNS)
                source_header_cell = worksheet.cell(row=header_row, column=anchor_col)
                worksheet.insert_cols(insert_at_col, amount=columns_to_insert)
                header_targets = [
                    (start_col + offset, new_header)
                    for offset, (new_header, _) in enumerate(LETTER_STATUS_INSERT_COLUMNS)
                ]

            for target_col, new_header in header_targets:
                header_cell = worksheet.cell(row=header_row, column=target_col)
                copy_cell_style(source_header_cell, header_cell)
                header_cell.value = new_header

                for row_index in range(header_row + 1, worksheet.max_row + 1):
                    row_source_cell = choose_style_source_cell(worksheet, row_index, [target_col - 1, anchor_col, target_col + 1])
                    copy_cell_style(row_source_cell, worksheet.cell(row=row_index, column=target_col))
        else:
            for offset, new_header in enumerate(expected_headers):
                worksheet.cell(row=header_row, column=start_col + offset).value = new_header

        rows_filled = 0
        for row_index in range(header_row + 1, worksheet.max_row + 1):
            if not row_has_values(worksheet, row_index):
                continue

            rows_filled += 1
            for offset, (_, fill_value) in enumerate(LETTER_STATUS_INSERT_COLUMNS):
                worksheet.cell(row=row_index, column=start_col + offset).value = fill_value

        insertion_details.append(
            {
                "Sheet": worksheet.title,
                "Header Row": header_row,
                "Insert Anchor": anchor_header,
                "Starting Column": get_column_letter(start_col),
                "Inserted New Columns": "Yes" if inserted_new_columns else "No",
                "Rows Filled": rows_filled,
            }
        )

    apply_safe_column_widths(workbook)
    output = BytesIO()
    workbook.save(output)
    output.seek(0)
    return output.getvalue(), insertion_details


def add_endorsement_columns_and_assign_agents(excel_bytes):
    workbook = openpyxl.load_workbook(BytesIO(excel_bytes))
    assignment_details = []
    state = load_agent_state()
    current_agent_index = (state["last_agent_index"] + 1) % len(AGENT_SEQUENCE)
    last_assigned_agent_index = state["last_agent_index"]
    rows_assigned_total = 0

    for worksheet in workbook.worksheets:
        account_position = find_header_position(worksheet, ACCOUNT_HEADER_CANDIDATES)
        if account_position is None:
            continue

        header_row, account_col, account_header = account_position
        header_values = {}
        for col_index in range(1, worksheet.max_column + 1):
            header_value = worksheet.cell(row=header_row, column=col_index).value
            if isinstance(header_value, str):
                header_values[header_value.strip().casefold()] = col_index

        agent_col = header_values.get(AGENT_HEADER.casefold())
        total_due_col = header_values.get(TOTAL_AMOUNT_DUE_HEADER.casefold())
        principal_amount_col = header_values.get(PRINCIPAL_AMOUNT_HEADER_CANDIDATES[0].casefold())
        interest_due_col = header_values.get(INTEREST_DUE_HEADER_CANDIDATES[0].casefold())
        late_penalty_col = header_values.get(LATE_PENALTY_HEADER_CANDIDATES[0].casefold())
        source_style_col = worksheet.max_column
        source_header_cell = worksheet.cell(row=header_row, column=source_style_col)
        inserted_columns = []

        if agent_col is None:
            agent_col = worksheet.max_column + 1
            inserted_columns.append(AGENT_HEADER)
            header_cell = worksheet.cell(row=header_row, column=agent_col)
            copy_cell_style(source_header_cell, header_cell)
            header_cell.value = AGENT_HEADER

            for row_index in range(header_row + 1, worksheet.max_row + 1):
                style_source_cell = choose_style_source_cell(worksheet, row_index, [account_col, source_style_col, agent_col - 1])
                copy_cell_style(style_source_cell, worksheet.cell(row=row_index, column=agent_col))

        if total_due_col is None:
            total_due_col = worksheet.max_column + 1
            inserted_columns.append(TOTAL_AMOUNT_DUE_HEADER)
            header_cell = worksheet.cell(row=header_row, column=total_due_col)
            copy_cell_style(source_header_cell, header_cell)
            header_cell.value = TOTAL_AMOUNT_DUE_HEADER

            for row_index in range(header_row + 1, worksheet.max_row + 1):
                style_source_cell = choose_style_source_cell(
                    worksheet,
                    row_index,
                    [principal_amount_col, interest_due_col, late_penalty_col, total_due_col - 1, source_style_col],
                )
                copy_cell_style(style_source_cell, worksheet.cell(row=row_index, column=total_due_col))

        sheet_rows_assigned = 0
        first_agent_assigned = ""
        last_agent_assigned = ""

        for row_index in range(header_row + 1, worksheet.max_row + 1):
            account_value = worksheet.cell(row=row_index, column=account_col).value
            if not has_meaningful_value(account_value):
                continue

            agent_value = AGENT_SEQUENCE[current_agent_index]
            worksheet.cell(row=row_index, column=agent_col).value = agent_value

            total_amount_due = (
                parse_numeric_value(worksheet.cell(row=row_index, column=principal_amount_col).value if principal_amount_col else None)
                + parse_numeric_value(worksheet.cell(row=row_index, column=interest_due_col).value if interest_due_col else None)
                + parse_numeric_value(worksheet.cell(row=row_index, column=late_penalty_col).value if late_penalty_col else None)
            )
            worksheet.cell(row=row_index, column=total_due_col).value = total_amount_due

            if not first_agent_assigned:
                first_agent_assigned = agent_value
            last_agent_assigned = agent_value
            sheet_rows_assigned += 1
            rows_assigned_total += 1
            last_assigned_agent_index = current_agent_index
            current_agent_index = (current_agent_index + 1) % len(AGENT_SEQUENCE)

        assignment_details.append(
            {
                "Sheet": worksheet.title,
                "Header Row": header_row,
                "Account Header": account_header,
                "Inserted Columns": ", ".join(inserted_columns) if inserted_columns else "No new columns added",
                "Rows Assigned": sheet_rows_assigned,
                "Total Due Source": ", ".join(
                    header_name
                    for header_name, header_col in [
                        ("PRINCIPAL_AMOUNT", principal_amount_col),
                        ("INTEREST_DUE", interest_due_col),
                        ("LATE_PENALTY_CHARGES", late_penalty_col),
                    ]
                    if header_col is not None
                ),
                "First Agent": first_agent_assigned,
                "Last Agent": last_agent_assigned,
            }
        )

    if rows_assigned_total > 0:
        save_agent_state(last_assigned_agent_index)
        saved_agent = AGENT_SEQUENCE[last_assigned_agent_index]
    else:
        saved_agent = state["last_agent"]

    apply_safe_column_widths(workbook)
    output = BytesIO()
    workbook.save(output)
    output.seek(0)
    return output.getvalue(), assignment_details, rows_assigned_total, saved_agent


def convert_xlsx_bytes_to_xls_bytes(excel_bytes):
    source_workbook = openpyxl.load_workbook(BytesIO(excel_bytes), data_only=False)
    target_workbook = xlwt.Workbook()
    color_cache = {}
    style_cache = {}

    for source_sheet in source_workbook.worksheets:
        target_sheet = target_workbook.add_sheet(source_sheet.title[:31] or "Sheet1")
        computed_widths = []

        for row_index, row in enumerate(source_sheet.iter_rows(values_only=False)):
            for col_index, cell in enumerate(row):
                value = cell.value

                if value is None:
                    continue

                while len(computed_widths) <= col_index:
                    computed_widths.append(0)
                computed_widths[col_index] = max(computed_widths[col_index], len(get_display_text(value)) + 2)

                style = build_xlwt_style(target_workbook, color_cache, style_cache, cell)
                target_sheet.write(row_index, col_index, value, style)

        for col_index in range(1, source_sheet.max_column + 1):
            source_letter = get_column_letter(col_index)
            source_width = source_sheet.column_dimensions[source_letter].width
            content_width = computed_widths[col_index - 1] if col_index - 1 < len(computed_widths) else 0
            final_width = max(source_width or 0, content_width, 12)
            target_sheet.col(col_index - 1).width = min(int(final_width * 256), 65535)

    output = BytesIO()
    target_workbook.save(output)
    output.seek(0)
    return output.getvalue()


def preview_sheet(excel_bytes, sheet_name, max_rows=25):
    return pd.read_excel(BytesIO(excel_bytes), sheet_name=sheet_name, engine="openpyxl").head(max_rows)


def preview_sheet_columns(excel_bytes, sheet_name, desired_columns, max_rows=25):
    preview_df = pd.read_excel(BytesIO(excel_bytes), sheet_name=sheet_name, engine="openpyxl")
    normalized_columns = {str(column_name).strip().casefold(): column_name for column_name in preview_df.columns}
    matched_columns = [
        normalized_columns[column_name.strip().casefold()]
        for column_name in desired_columns
        if column_name.strip().casefold() in normalized_columns
    ]

    if matched_columns:
        return preview_df[matched_columns].head(max_rows)

    return preview_df.head(max_rows)


